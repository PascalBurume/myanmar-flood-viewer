{
  "name": "myanmar-flood-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Viewer for satellite-detected flood extents and impact figures across Myanmar (UNOSAT, WFP ADAM)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pipeline": "python3 scripts/run_pipeline.py",
    "pipeline:publish": "python3 scripts/run_pipeline.py --publish \"${PUBLISH_DIR:?set PUBLISH_DIR to your web root}\"",
    "update-data": "python3 scripts/run_pipeline.py",
    "check-data": "python3 scripts/run_pipeline.py --dry-run",
    "status": "python3 scripts/status.py --print",
    "serve": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
