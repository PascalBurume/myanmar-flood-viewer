# Copy this file to `.env` and fill in the key:
#
#     cp .env.example .env
#
# `.env` is gitignored. A real environment variable overrides anything set here, so
# `ANTHROPIC_API_KEY=... npm start` still wins for a one-off.

# Enables the panel's Assistant tab. Everything else in the viewer works without it.
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# Optional. How hard the model thinks: low | medium | high | xhigh | max.
# Defaults to medium. Raise it if answers look shallow; it costs more thinking tokens.
# CHAT_EFFORT=medium
