# Copy this file to `.env` and fill in the key:
#
#     cp .env.example .env
#
# `.env` is gitignored. A real environment variable overrides anything set here, so
# `ANTHROPIC_API_KEY=... npm start` still wins for a one-off.

# Enables the panel's Assistant tab. Everything else in the viewer works without it.
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# Optional. How hard the model thinks: low | medium | high | xhigh | max.
# Defaults to medium. Raise it if answers look shallow; it costs more thinking tokens.
# CHAT_EFFORT=medium


# ---- WeatherNext 3 forecast field (optional; phase 2) ----
# All four are needed before the stage runs; until then it records `skipped` with the first
# missing one. Access is a Google Account on Google's WeatherNext allow-list (request form,
# 5–7 business days): https://developers.google.com/weathernext/guides/access-forecast
#
# The Google Cloud project billed for Requester-Pays egress from the full-ensemble bucket.
# WEATHERNEXT_PROJECT=
# A service-account key for an allow-listed account, or run `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=
# The reducer's own virtualenv (python3.11+, see scripts/wn3_requirements.txt). Default .venv-wn3
# WEATHERNEXT_VENV=.venv-wn3
# Set to 1 only after reading the GDM Real-Time Weather Forecasting Experimental Data Terms and
# deciding whether this site may redistribute the field. Credentials alone publish nothing.
# WEATHERNEXT_ACCEPTED_TERMS=
# Egress cap per run in GB; the reducer estimates its read from the chunk grid first. Default 5
# WEATHERNEXT_MAX_GB=5


# ---- Forecast field (Open-Meteo; the Weather view) ----
# Keyless and free for non-commercial use, about 10,000 weighted calls a day. A full run is roughly
# 2,700; a model whose current run is already on disk is not fetched again.
# Which models to fetch (ecmwf | gfs | icon). Default all three.
# FIELD_MODELS=ecmwf,gfs,icon
# Fetch the 51-member ECMWF ensemble for the probability layers. Default 1.
# FIELD_ENSEMBLE=1
# Runs kept per model, for the init stepper. Default 8.
# FIELD_KEEP_RUNS=8
# For models that publish no run time (GFS, ICON): hours before refetching. Default 5.
# FIELD_MIN_REFETCH_H=5
